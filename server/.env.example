PORT=7000
JWT_SECRET=change-me
HOSTED_ORIGIN=https://your-frontend.example.com
LOCALHOST_ORIGIN=http://localhost:5173
CORS_EXPOSED_HEADER=set-cookie
CORS_SAME_SITE=none

# Either a single connection string...
DATABASE_URL=postgres://user:password@localhost:5432/voting
# ...or the individual settings (used when DATABASE_URL is empty)
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=voting
POSTGRESQL_USER=postgres
POSTGRESQL_PASSWORD=
